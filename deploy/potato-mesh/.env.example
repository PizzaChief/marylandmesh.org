# Copy to .env on the server and set a new, private API_TOKEN.
POTATOMESH_IMAGE_ARCH=linux-arm64
POTATOMESH_IMAGE_TAG=v1.0.0
SITE_NAME=Maryland Mesh Monitor
INSTANCE_DOMAIN=https://monitor.marylandmesh.org
API_TOKEN=replace-with-a-long-random-secret
MESHTASTIC_PRESET=#LongFast
MESHTASTIC_FREQ=906.875MHz
MAP_CENTER=39.0,-76.7
MAP_ZOOM=8
CONTACT_LINK=https://marylandmesh.org/
FEDERATION=0

# Needed only when enabling the optional ingestor profile. Example:
# CONNECTION=192.168.1.20:4403
